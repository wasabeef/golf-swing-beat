{
  "name": "golf-swing-beat",
  "version": "0.1.0",
  "description": "A browser-based golf swing tempo trainer with light and sound",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wasabeef/golf-swing-beat.git"
  },
  "homepage": "https://wasabeef.github.io/golf-swing-beat/",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "serve": "python3 -m http.server 8000",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
